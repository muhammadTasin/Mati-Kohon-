{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "apps/saao-dashboard/public",
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "/api" }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "{services/api/**/*.ts,services/api/data/**,services/api/fixtures/**,packages/**/*.ts,packages/**/*.json}"
    }
  }
}
